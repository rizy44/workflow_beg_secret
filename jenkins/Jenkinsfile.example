// Jenkins calls the SAME stage scripts as GitHub Actions (scripts/ in workflow_beg_secret).
// Helm/JCasC creates the job; this file shows the flow.
//
// Bootstrap credentials in Jenkins (the only ones not managed by OpenBao):
//   bao-role-id, bao-secret-id   (Secret text, AppRole of the OpenBao namespace)
// Agent needs python3 >= 3.10 (no pip packages for fetch_secrets.py).

pipeline {
  agent any

  options {
    timestamps()
    disableConcurrentBuilds()
  }

  environment {
    BAO_ADDR      = 'https://openbao.example.com:8200'
    BAO_NAMESPACE = 'CHANGE_ME'          // your OpenBao namespace
    BAO_MOUNT     = 'kv/test'
    CI_SCRIPTS    = "${env.WORKSPACE}/.workflow_beg_secret/scripts"
    FETCH         = "python3 ${env.WORKSPACE}/.workflow_beg_secret/scripts/openbao/fetch_secrets.py"
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
        dir('.workflow_beg_secret') {
          git url: 'https://github.com/rizy44/workflow_beg_secret.git', branch: 'main'
        }
      }
    }

    // Each stage: fetch_secrets.py logs in (AppRole), reads the spec, then exec's the
    // stage script with the secrets in its environment. Nothing is written to disk and
    // the OpenBao token is revoked before the script starts.
    stage('Test') {
      steps {
        withCredentials([string(credentialsId: 'bao-role-id', variable: 'BAO_ROLE_ID'),
                         string(credentialsId: 'bao-secret-id', variable: 'BAO_SECRET_ID')]) {
          sh '$FETCH --spec-file .ci/secrets.txt --exec -- ./scripts/test.sh'
        }
      }
    }

    stage('Build') {
      steps {
        withCredentials([string(credentialsId: 'bao-role-id', variable: 'BAO_ROLE_ID'),
                         string(credentialsId: 'bao-secret-id', variable: 'BAO_SECRET_ID')]) {
          sh '$FETCH --spec-file .ci/secrets.txt --exec -- ./scripts/build.sh'
        }
      }
    }
  }

  post {
    always {
      dir('.workflow_beg_secret') { deleteDir() }
    }
  }
}
